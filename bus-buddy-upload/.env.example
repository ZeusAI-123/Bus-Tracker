# Bus Buddy settings. Copy this file to .env (same folder) and fill in what you need.
# .env holds real keys and passwords: never commit it. This example file has placeholders only.
#
# Sample mode (the default) needs none of the keys below: data comes from data/sample/ and the
# AI answers are replayed from data/recordings/.

# ---- Mode ---------------------------------------------------------------------------------
# true  = local data (data/sample/ with DuckDB)      false = query the Zetaris cluster
SAMPLE_MODE=true
# true = call Nightshift even in sample mode (used to record new AI answers)
AI_LIVE=false
# record = save new AI answers to data/recordings/ and reuse the ones already saved
AI_RECORDING=record

# ---- Meterless Nightshift (AI provider, runs NVIDIA Nemotron) -----------------------------
# Address and API key from Nightshift's Console ("This computer"). The NVIDIA key goes in
# Nightshift's provider settings, never here.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-api-key
MODEL_REASONING=nvidia/nemotron-3.5-lightning-30b-a3b
MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
MODEL_TIMEOUT_SECONDS=60

# ---- Zetaris (data layer), used when SAMPLE_MODE=false -------------------------------------
# Site address of your managed cluster (Overview > Access), without /login at the end
ZETARIS_REST_URL=https://your-cluster.cloud.zetaris.com
ZETARIS_ORG_ID=1
ZETARIS_USERNAME=your-zetaris-login-email
ZETARIS_PASSWORD=your-zetaris-password
# Source name the tables are registered under, with a dot at the end
ZETARIS_PG_PREFIX=bustracker.
ZETARIS_POSITIONS_TABLE=bustracker.vehicle_positions
ZETARIS_WEATHER_TABLE=bustracker.weather_hourly
ZETARIS_TIMEOUT_SECONDS=180
ZETARIS_ROW_LIMIT=100000

# ---- App -------------------------------------------------------------------------------------
TIMEZONE=Australia/Sydney
PORT=8000
